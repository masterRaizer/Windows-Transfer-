<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform>AnyCPU</Platform>
    <ProjectGuid>{6B0C6E2B-6B0E-4D0C-9A53-7C1F6E0B5A11}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Transfer</RootNamespace>
    <AssemblyName>Transfer</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\</OutputPath>
    <WarningLevel>3</WarningLevel>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Xaml" />
    <Reference Include="System.Management" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" /><Reference Include="System.Xml" /><Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" /><Reference Include="PresentationCore" /><Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml"><Generator>MSBuild:Compile</Generator></ApplicationDefinition>
    <Page Include="MainWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Compile Include="App.xaml.cs"><DependentUpon>App.xaml</DependentUpon></Compile>
    <Compile Include="MainWindow.xaml.cs"><DependentUpon>MainWindow.xaml</DependentUpon></Compile>
    <Compile Include="Util.cs" /><Compile Include="Errors.cs" /><Compile Include="Engine.cs" /><Compile Include="Flows.cs" /><Compile Include="Clone.cs" /><Compile Include="Images.cs" /><Compile Include="Hardware.cs" /><Compile Include="Security.cs" /><Compile Include="Sentinel.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <EmbeddedResource Include="ps\collect.ps1" />
    <!-- встроенный антивирус Sentinel (собирается scripts/update-sentinel.sh); без архива программа собирается и ищет установленный Sentinel -->
    <!-- архив больше 90 МБ лежит частями sentinel.zip.part1, .part2, … (лимит GitHub — 100 МБ на файл); программа склеивает их сама -->
    <EmbeddedResource Include="sentinel\sentinel.zip" Condition="Exists('sentinel\sentinel.zip')"><LogicalName>Transfer.sentinel.zip</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="sentinel\sentinel.zip.part*"><LogicalName>Transfer.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <None Include="app.manifest" />
    <Resource Include="app.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
