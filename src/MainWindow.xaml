<Window x:Class="Transfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перенос программ и настроек" Width="1080" Height="840" MinWidth="960" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Ui}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Task"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <!-- Строка этапа: значок состояния + название + пояснение -->
        <DataTemplate x:Key="StepTpl">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Ellipse x:Name="ring" Stroke="{StaticResource Line}" StrokeThickness="2"/>
                    <TextBlock x:Name="ico" FontFamily="{StaticResource Ico}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ttl" Text="{Binding Title}" Foreground="{StaticResource Mute}" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock x:Name="det" Text="{Binding Detail}" Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="det" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="run">
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/>
                    <Setter TargetName="ico" Property="Text" Value="&#xE895;"/>
                    <Setter TargetName="ico" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="ttl" Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter TargetName="ttl" Property="FontWeight" Value="SemiBold"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="spin">
                            <Storyboard><DoubleAnimation Storyboard.TargetName="ico" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.6" RepeatBehavior="Forever"/></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="spin"/></DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ok">
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Ok}"/>
                    <Setter TargetName="ring" Property="Fill" Value="{StaticResource Ok}"/>
                    <Setter TargetName="ico" Property="Text" Value="&#xE73E;"/>
                    <Setter TargetName="ico" Property="Foreground" Value="#0E1014"/>
                    <Setter TargetName="ttl" Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="warn">
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Warn}"/>
                    <Setter TargetName="ring" Property="Fill" Value="{StaticResource Warn}"/>
                    <Setter TargetName="ico" Property="Text" Value="&#xE783;"/>
                    <Setter TargetName="ico" Property="Foreground" Value="#0E1014"/>
                    <Setter TargetName="ttl" Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter TargetName="det" Property="Foreground" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="fail">
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Bad}"/>
                    <Setter TargetName="ring" Property="Fill" Value="{StaticResource Bad}"/>
                    <Setter TargetName="ico" Property="Text" Value="&#xE711;"/>
                    <Setter TargetName="ico" Property="Foreground" Value="#0E1014"/>
                    <Setter TargetName="ttl" Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка «что не скопировалось» -->
        <DataTemplate x:Key="ProblemTpl">
            <Border Style="{StaticResource CardBox}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="pill" DockPanel.Dock="Left" CornerRadius="5" Padding="7,2" Background="#1F3DD68C" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="pillT" Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Ok}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Mute}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Explain}" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Что делать:  " Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Action}" TextWrapping="Wrap" TextTrimming="None" Foreground="{StaticResource Text}"/>
                    </DockPanel>
                    <ToggleButton x:Name="more" Margin="0,10,0,0" HorizontalAlignment="Left" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <TextBlock x:Name="t" Text="Показать файлы" Foreground="{StaticResource Accent}" FontSize="13"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="t" Property="Text" Value="Скрыть файлы"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Border Background="#0E1014" CornerRadius="8" Padding="10" Margin="0,8,0,0" MaxHeight="170" Visibility="{Binding IsChecked, ElementName=more, Converter={StaticResource B2V}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SamplesText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Mute}" FontFamily="Consolas" FontSize="12"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="1">
                    <Setter TargetName="pill" Property="Background" Value="#1FF5B94A"/>
                    <Setter TargetName="pillT" Property="Foreground" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="2">
                    <Setter TargetName="pill" Property="Background" Value="#1FFF6B6B"/>
                    <Setter TargetName="pillT" Property="Foreground" Value="{StaticResource Bad}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Grid Background="{StaticResource Side}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource Grad}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Ico}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Перенос" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleNote" Text="" Foreground="{StaticResource Dim}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BtnChrome}" Content="&#xE921;" Click="Min_Click" ToolTip="Свернуть"/>
                    <Button Style="{StaticResource BtnChrome}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>

            <!-- ================= ГЛАВНЫЙ ЭКРАН ================= -->
            <Grid x:Name="HomeView" Grid.Row="1" Margin="44,30,44,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Перенос программ, настроек и файлов"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="Сохрани всё со старого компьютера на этот диск, потом подключи диск к новому и восстанови."/>
                    <TextBlock x:Name="HwLine" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0" Text=""/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Cap}" Text="ДИСК ПЕРЕНОСА"/>
                            <TextBlock x:Name="DriveTitle" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="F:"/>
                            <ProgressBar x:Name="DriveBar" Style="{StaticResource Bar}" Height="8" Margin="0,12,0,8" Value="0.5"/>
                            <TextBlock x:Name="DriveNote" Style="{StaticResource Sub}" Text=""/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="CopyPill" DockPanel.Dock="Right" CornerRadius="5" Padding="7,2" Background="#1F3DD68C" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="CopyPillText" Text="ГОТОВА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Ok}"/>
                                </Border>
                                <TextBlock Style="{StaticResource Cap}" Text="КОПИЯ НА ЭТОМ ДИСКЕ"/>
                            </DockPanel>
                            <TextBlock x:Name="CopyTitle" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="Пока ничего не сохранено"/>
                            <TextBlock x:Name="CopyNote" Style="{StaticResource Sub}" Margin="0,6,0,0" Text=""/>
                            <TextBlock x:Name="CopyLink" Margin="0,8,0,0" Foreground="{StaticResource Accent}" Cursor="Hand" MouseLeftButtonUp="CopyLink_Click" Visibility="Collapsed" Text="Посмотреть замечания"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBox}" Padding="24">
                        <DockPanel>
                            <Button x:Name="BackupBtn" DockPanel.Dock="Bottom" Style="{StaticResource BtnPrimary}" Content="Сохранить с этого компьютера" Click="Backup_Click" Margin="0,18,0,0"/>
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="12" Background="#1F5B8CFF" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource Ico}" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Шаг 1 · На старом компьютере" Style="{StaticResource Cap}" Margin="0,16,0,0"/>
                                <TextBlock Text="Сохранить" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource UiBig}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="BackupNote" Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Документы, настройки и данные всех программ, папки программ, Wi-Fi и список установленного. Занятые файлы тоже копируются."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="24">
                        <DockPanel>
                            <Button x:Name="RestoreBtn" DockPanel.Dock="Bottom" Style="{StaticResource Btn}" Content="Восстановить на этот компьютер" Click="Restore_Click" Margin="0,18,0,0"/>
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="12" Background="#1F3DD68C" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Ico}" FontSize="20" Foreground="{StaticResource Ok}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Шаг 2 · На новом компьютере" Style="{StaticResource Cap}" Margin="0,16,0,0"/>
                                <TextBlock Text="Восстановить" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource UiBig}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="RestoreNote" Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Сама поставит программы, вернёт файлы и настройки на место и покажет, что осталось доделать руками."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="3" Style="{StaticResource CardBox}" Margin="0,16,0,0" Padding="20,16">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="#1F8B5CFF" VerticalAlignment="Top" Margin="0,2,16,0">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Ico}" FontSize="20" Foreground="#A98BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Образы Windows: клоны и шаблоны" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CloneNote" Style="{StaticResource Sub}" FontSize="13" Margin="0,4,0,0" Text=""/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="CloneCapBtn" Style="{StaticResource Btn}" Padding="14,8" Content="Снять клон" Click="CloneCap_Click" Margin="0,0,10,0"/>
                                <Button x:Name="TemplateBtn" Style="{StaticResource Btn}" Padding="14,8" Content="Добавить шаблон" Click="TemplateAdd_Click" Margin="0,0,10,0"/>
                                <Button x:Name="CloneApplyBtn" Style="{StaticResource BtnPrimary}" Padding="14,8" Content="Развернуть образ" Click="CloneApply_Click" Margin="0,0,10,0"/>
                                <Button x:Name="CloneFinishBtn" Style="{StaticResource Btn}" Padding="14,8" Content="Убрать вторую Windows" Click="CloneFinish_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="HomeHint" Grid.Row="4" Style="{StaticResource Sub}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,16,0,0"
                           Text="Пока идёт перенос, компьютер не уснёт. Диск можно отключать только после сообщения «Готово»."/>
            </Grid>

            <!-- ================= ВЫБОР ШАГОВ ВОССТАНОВЛЕНИЯ ================= -->
            <Grid x:Name="OptView" Grid.Row="1" Margin="44,30,44,24" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Что восстановить на этом компьютере"/>
                    <TextBlock x:Name="OptSub" Style="{StaticResource Sub}" Margin="0,6,0,0" Text=""/>
                    <Border x:Name="OptWarn" CornerRadius="10" Background="#1FF5B94A" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="OptWarnText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" TextTrimming="None"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OptList" Margin="0,0,10,0"/>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Назад" Click="Home_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Начать восстановление" Click="RestoreStart_Click"/>
                </DockPanel>
            </Grid>

            <!-- ================= ЭКРАН ПРОГРЕССА ================= -->
            <Grid x:Name="RunView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="26,28,22,24">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="ЭТАПЫ" Margin="0,0,0,18"/>
                        <TextBlock x:Name="RunHint" DockPanel.Dock="Bottom" Style="{StaticResource Sub}" Foreground="{StaticResource Dim}" FontSize="12"
                                   Text="Компьютером можно пользоваться. Не отключай диск и не закрывай крышку ноутбука."/>
                        <ItemsControl x:Name="StepsList" ItemTemplate="{StaticResource StepTpl}"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1" Margin="40,30,40,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="RunTitle" Style="{StaticResource Cap}" Text="СОХРАНЕНИЕ"/>
                        <TextBlock x:Name="RunActivity" Style="{StaticResource H1}" Margin="0,6,0,0" Text="Подготовка"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="RunPercent" Text="0%" FontFamily="{StaticResource UiBig}" FontSize="64" FontWeight="SemiBold" Margin="0,-10,22,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid Height="12">
                                <ProgressBar x:Name="RunBar" Style="{StaticResource Bar}" Value="0"/>
                                <!-- бегущая полоска для этапов, где объём заранее неизвестен -->
                                <Border x:Name="IndetBox" CornerRadius="6" ClipToBounds="True" Visibility="Collapsed">
                                    <Border Width="160" CornerRadius="6" Background="{StaticResource Grad}" HorizontalAlignment="Left">
                                        <Border.RenderTransform><TranslateTransform x:Name="IndetMove" X="-160"/></Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="RunStat" Style="{StaticResource Sub}" Margin="0,10,0,0" Text=""/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="2" Rows="1" Margin="-6,22,-6,0">
                        <Border Style="{StaticResource CardBox}" Margin="6,0" Padding="16,14">
                            <StackPanel><TextBlock Style="{StaticResource Cap}" Text="СКОПИРОВАНО"/><TextBlock x:Name="TileDone" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" Text="—"/><TextBlock x:Name="TileDoneSub" Foreground="{StaticResource Dim}" FontSize="12" Text=""/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="6,0" Padding="16,14">
                            <StackPanel><TextBlock Style="{StaticResource Cap}" Text="СКОРОСТЬ"/><TextBlock x:Name="TileSpeed" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" Text="—"/><TextBlock x:Name="TileFiles" Foreground="{StaticResource Dim}" FontSize="12" Text=""/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="6,0" Padding="16,14">
                            <StackPanel><TextBlock Style="{StaticResource Cap}" Text="ПРОШЛО"/><TextBlock x:Name="TileElapsed" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" Text="0:00:00"/><TextBlock Foreground="{StaticResource Dim}" FontSize="12" Text="с начала"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="6,0" Padding="16,14">
                            <StackPanel><TextBlock Style="{StaticResource Cap}" Text="ОСТАЛОСЬ"/><TextBlock x:Name="TileEta" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" Text="—"/><TextBlock x:Name="TileEtaSub" Foreground="{StaticResource Dim}" FontSize="12" Text=""/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" Style="{StaticResource CardBox}" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="NowCount" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" FontSize="12" Text=""/>
                                <TextBlock Style="{StaticResource Cap}" Text="СЕЙЧАС"/>
                            </DockPanel>
                            <TextBlock x:Name="NowJob" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" Text=""/>
                            <TextBlock x:Name="NowFile" Foreground="{StaticResource Mute}" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" Text=""/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <!-- диск переноса отключился -->
                        <Border x:Name="DeviceBox" CornerRadius="12" Background="#1FFF6B6B" BorderBrush="{StaticResource Bad}" BorderThickness="1" Padding="18" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Диск переноса отключился" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Bad}"/>
                                <TextBlock Style="{StaticResource Sub}" Foreground="{StaticResource Text}" Margin="0,6,0,0"
                                           Text="Компьютер перестал видеть съёмный диск — обычно из-за кабеля или разъёма. Ничего не потеряно. Подключи диск обратно (лучше напрямую в разъём на корпусе, без хаба) — копирование продолжится само с того же места."/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ErrBox" CornerRadius="12" Background="#14F5B94A" Padding="16,12" Visibility="Collapsed">
                            <TextBlock x:Name="ErrText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" TextTrimming="None"/>
                        </Border>
                    </StackPanel>

                    <DockPanel Grid.Row="5" LastChildFill="False">
                        <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Отменить" Click="Cancel_Click"/>
                        <Button x:Name="PauseBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Пауза" Click="Pause_Click" Margin="0,0,10,0"/>
                        <Button x:Name="SkipBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Пропустить проверку" Click="Skip_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ================= ИТОГ ================= -->
            <Grid x:Name="DoneView" Grid.Row="1" Margin="44,28,44,24" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="DoneIconBox" Width="56" Height="56" CornerRadius="28" Background="#1F3DD68C" VerticalAlignment="Top" Margin="0,2,18,0">
                        <TextBlock x:Name="DoneIcon" Text="&#xE73E;" FontFamily="{StaticResource Ico}" FontSize="24" Foreground="{StaticResource Ok}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Text="Готово" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock x:Name="DoneText" Style="{StaticResource Sub}" Margin="0,6,0,0" Text=""/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Cap}" Text="ИТОГИ"/>
                                <ItemsControl x:Name="DoneSummary" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Mute}" Margin="0,2" TextWrapping="Wrap" TextTrimming="None"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ProblemsCap" Style="{StaticResource Cap}" Text="ЧТО НЕ СКОПИРОВАЛОСЬ И ПОЧЕМУ" Margin="2,8,0,10"/>
                        <ItemsControl x:Name="ProblemsList" ItemTemplate="{StaticResource ProblemTpl}"/>
                    </StackPanel>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="На главную" Click="Home_Click"/>
                    <Button x:Name="ReportBtn" DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Открыть отчёт" Click="Report_Click" Margin="10,0,0,0"/>
                    <Button x:Name="ManualBtn" DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Что поставить вручную" Click="Manual_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="AgainBtn" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Досохранить" Click="Backup_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
